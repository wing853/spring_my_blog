{{> layout/header}}

<style>
    /* 전체 배경색 조정 */
    body {
        background-color: #f1f5f9;
    }

    /* 카드 리스트 스타일 */
    .board-card {
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 12px;
        background: #ffffff;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
        position: relative;
    }

    .board-card:hover {
        border-color: #6366f1; /* 포인트 컬러 */
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
        transform: translateY(-3px);
    }

    /* 카드 왼쪽 포인트 바 */
    .board-card::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        height: 100%;
        width: 4px;
        background-color: #6366f1;
        opacity: 0;
        transition: opacity 0.3s;
    }

    .board-card:hover::before {
        opacity: 1;
    }

    .card-title {
        font-weight: 700;
        color: #1e293b;
        font-size: 1.3rem;
        margin-bottom: 0.8rem;
    }

    /* 작성자 및 시간 스타일 */
    .board-info {
        font-size: 0.9rem;
        color: #64748b;
        display: flex;
        align-items: center;
        gap: 15px; /* 아이템 간 간격 */
    }

    .info-item {
        display: flex;
        align-items: center;
    }

    .info-item i {
        color: #6366f1; /* 아이콘 색상 통일 */
        font-size: 1rem;
    }

    .author-name {
        font-weight: 700;
        color: #334155;
        margin-left: 5px;
    }

    /* 상세보기 버튼 */
    .btn-detail {
        background-color: #334155;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 0.6rem 1.2rem;
        transition: all 0.2s;
        text-decoration: none;
    }

    .btn-detail:hover {
        background-color: #6366f1;
        color: white;
        box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
    }

    /* 페이지네이션 커스텀 */
    .pagination .page-link {
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        color: #475569;
        margin: 0 3px;
        border-radius: 8px !important;
        padding: 0.6rem 1.1rem;
        transition: all 0.2s;
        font-weight: 500;
    }

    .pagination .page-item.active .page-link {
        background-color: #1e293b;
        border-color: #1e293b;
        color: white;
    }

    .pagination .page-item.disabled .page-link {
        background-color: #f8fafc;
        color: #cbd5e1;
        pointer-events: none;
    }
</style>

<div class="container py-5 flex-grow-1">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <!-- 섹션 헤더 -->
            <div class="mb-5 ps-2">
                <h3 class="fw-bold text-dark">최신 포스트</h3>
                <div style="width: 45px; height: 4px; background: #6366f1; border-radius: 2px;"></div>
            </div>

            <!-- 게시글 리스트 -->
            {{#boardList}}
                <div class="card mb-4 board-card shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="card-title">{{title}}</h4>
                                <div class="board-info">
                                    <!-- 작성자 아이콘 + 이름 -->
                                    <div class="info-item">
                                        <i class="fa-solid fa-circle-user"></i>
                                        <span class="author-name">{{user.username}}</span>
                                    </div>
                                    <!-- 날짜 아이콘 + 시간 -->
                                    <div class="info-item">
                                        <i class="fa-regular fa-calendar-check me-1"></i>
                                        <span>{{time}}</span>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <a href="/board/{{id}}" class="btn btn-detail">읽어보기</a>
                            </div>
                        </div>
                    </div>
                </div>
            {{/boardList}}

            <!-- 동적 페이지네이션 -->
            <nav class="mt-5">
                <ul class="pagination d-flex justify-content-center">

                    <!-- 이전 페이지 -->
                    <li class="page-item {{#first}}disabled{{/first}}">
                        <a class="page-link" href="?page={{prevPage}}">
                        <i class="fa-solid fa-angle-left"></i>
                        </a>
                    </li>

                    <!-- 페이지 번호 리스트 -->
                    {{#pageNumbers}}
                        <li class="page-item {{#active}}active{{/active}}">
                            <a class="page-link" href="?page={{data}}">{{display}}</a>
                        </li>
                    {{/pageNumbers}}

                    <!-- 다음 페이지 -->
                    <li class="page-item {{#last}}disabled{{/last}}">
                        <a class="page-link" href="?page={{nextPage}}">
                        <i class="fa-solid fa-angle-right"></i>
                        </a>
                    </li>

                </ul>
            </nav>

        </div>
    </div>
</div>

{{> layout/footer}}