{{> layout/header}}

<style>
    /* 기본 배경 및 폰트 */
    body {
        background-color: #f8fafc;
        font-family: 'Pretendard', -apple-system, sans-serif;
    }

    /* 글수정 카드 컨테이너 */
    .write-wrapper {
        max-width: 800px;
        margin: 50px auto;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }

    /* 카드 헤더 - 진한 경계선 스타일 유지 */
    .write-header {
        padding: 30px 40px;
        background-color: #ffffff;
        border-bottom: 2px solid #cbd5e1;
        text-align: center;
    }

    .write-header h2 {
        font-weight: 800;
        font-size: 1.8rem;
        color: #1e293b;
        letter-spacing: -1px;
        margin: 0;
    }

    /* 폼 영역 */
    .write-body {
        padding: 40px;
    }

    /* 입력창 스타일 */
    .custom-input {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 12px 18px;
        font-size: 1rem;
        transition: all 0.3s;
        background-color: #fcfdfe;
        color: #334155;
    }

    .custom-input:focus {
        background-color: #ffffff;
        border-color: #1e293b;
        box-shadow: 0 0 0 4px rgba(30, 41, 59, 0.05);
        outline: none;
    }

    .input-label {
        font-weight: 700;
        font-size: 0.9rem;
        color: #475569;
        margin-bottom: 8px;
        display: block;
        margin-left: 5px;
    }

    /* 글수정 완료 버튼 */
    .btn-write-submit {
        background-color: #1e293b;
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 15px;
        width: 100%;
        font-weight: 700;
        font-size: 1.1rem;
        transition: all 0.3s;
        margin-top: 20px;
        cursor: pointer;
        text-decoration: none;
        display: block;
        text-align: center;
    }

    .btn-write-submit:hover {
        background-color: #0f172a;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    textarea.custom-input {
        resize: none;
        line-height: 1.6;
    }
</style>

<div class="container flex-grow-1">
    <div class="write-wrapper">
        <div class="write-header">
            <h2><i class="fa-solid fa-pen-to-square me-2"></i>포스트 수정하기</h2>
        </div>

        <div class="write-body">
            <form action="/board/{{board.id}}/update" method="post">
                <div class="mb-4">
                    <label class="input-label">작성자</label>
                    <input type="text" name="username" class="form-control custom-input"
                           placeholder="이름을 입력하세요" value="{{board.username}}">
                </div>

                <div class="mb-4">
                    <label class="input-label">제목</label>
                    <input type="text" name="title" class="form-control custom-input"
                           placeholder="제목을 수정하세요" value="{{board.title}}">
                </div>

                <div class="mb-4">
                    <label class="input-label">내용</label>
                    <textarea name="content" rows="8" class="form-control custom-input"
                              placeholder="내용을 수정하세요...">{{board.content}}</textarea>
                </div>

                <button type="submit" class="btn-write-submit">
                    글수정 완료
                </button>
            </form>
        </div>
    </div>
</div>

{{> layout/footer}}