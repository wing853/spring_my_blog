{{> layout/header}}

<style>
    body {
        background-color: #f1f5f9;
    }

    .error-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .error-card {
        width: 100%;
        max-width: 650px;
        background: #ffffff;
        border-radius: 20px;
        padding: 60px 50px;
        text-align: center;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.04);
        position: relative;
        overflow: hidden;
    }

    /* 상단 포인트 컬러 */
    .error-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 6px;
        background: #6366f1;
    }

    .error-icon {
        font-size: 4rem;
        color: #6366f1;
        margin-bottom: 25px;
    }

    .error-code {
        font-size: 5rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 10px;
        letter-spacing: -2px;
    }

    .error-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #334155;
        margin-bottom: 15px;
    }

    .error-message {
        color: #64748b;
        font-size: 1rem;
        line-height: 1.7;
        margin-bottom: 35px;
    }

    .btn-group-custom {
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .btn-custom {
        padding: 0.8rem 1.5rem;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-login {
        background-color: #334155;
        color: white;
    }

    .btn-login:hover {
        background-color: #6366f1;
        color: white;
        box-shadow: 0 6px 18px rgba(99, 102, 241, 0.25);
    }

    .btn-home {
        background-color: #e2e8f0;
        color: #334155;
    }

    .btn-home:hover {
        background-color: #cbd5e1;
        color: #0f172a;
    }
</style>

<div class="container error-wrapper">

    <div class="error-card">

        <!-- 아이콘 -->
        <div class="error-icon">
            <i class="fa-solid fa-lock"></i>
        </div>

        <!-- 에러 코드 -->
        <div class="error-code">
            401
        </div>

        <!-- 제목 -->
        <div class="error-title">
            인증이 필요합니다
        </div>

        <!-- 메시지 -->
        <div class="error-message">
            {{msg}}
        </div>

        <!-- 버튼 -->
        <div class="btn-group-custom">

            <a href="/login-form" class="btn-custom btn-login">
                로그인하기
            </a>

            <a href="/" class="btn-custom btn-home">
                메인 페이지
            </a>

        </div>

    </div>

</div>

{{> layout/footer}}