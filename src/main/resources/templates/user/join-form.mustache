{{> layout/header}}

<style>
    /* 기본 배경색 */
    body {
        background-color: #f1f5f9;
    }

    /* 회원가입 카드 컨테이너 */
    .join-wrapper {
        max-width: 500px;
        margin: 60px auto;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }

    /* 카드 헤더 - 진한 하단 경계선 */
    .join-header {
        padding: 40px 20px 25px;
        background-color: #ffffff;
        border-bottom: 2px solid #cbd5e1;
        text-align: center;
    }

    .join-header h2 {
        font-weight: 800;
        font-size: 1.7rem;
        color: #1e293b;
        letter-spacing: -1px;
        margin: 0;
    }

    .join-header p {
        color: #64748b;
        font-size: 0.95rem;
        margin-top: 10px;
    }

    /* 폼 영역 */
    .join-body {
        padding: 40px;
    }

    /* 입력창 커스텀 스타일 */
    .custom-input {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px 18px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        background-color: #fcfdfe;
        color: #334155;
    }

    .custom-input:focus {
        background-color: #ffffff;
        border-color: #6366f1; /* 헤더의 로고 포인트 컬러 */
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        outline: none;
    }

    .input-label {
        font-weight: 700;
        font-size: 0.85rem;
        color: #475569;
        margin-bottom: 8px;
        display: block;
        margin-left: 4px;
    }

    /* 회원가입 버튼 */
    .btn-join-submit {
        background-color: #1e293b; /* 헤더와 어울리는 다크 톤 */
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 15px;
        width: 100%;
        font-weight: 700;
        font-size: 1.05rem;
        transition: all 0.3s;
        margin-top: 10px;
        cursor: pointer;
    }

    .btn-join-submit:hover {
        background-color: #0f172a;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    /* 하단 링크 */
    .join-footer {
        text-align: center;
        padding: 20px;
        background-color: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

    .join-footer a {
        color: #6366f1;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
    }
</style>

<div class="container flex-grow-1">
    <div class="join-wrapper">
        <!-- 헤더 영역 -->
        <div class="join-header">
            <h2>반가워요! <i class="fa-solid fa-user-plus ms-1"></i></h2>
            <p>Tencoding Blog의 새로운 멤버가 되어주세요</p>
        </div>

        <!-- 폼 영역 -->
        <div class="join-body">
            <form action="/join" method="post">
                <!-- Username -->
                <div class="mb-4">
                    <label class="input-label">아이디</label>
                    <input type="text" name="username" class="form-control custom-input" placeholder="사용할 아이디를 입력하세요">
                </div>

                <!-- Password -->
                <div class="mb-4">
                    <label class="input-label">비밀번호</label>
                    <input type="password" name="password" class="form-control custom-input" placeholder="비밀번호를 입력하세요">
                </div>

                <!-- Email -->
                <div class="mb-4">
                    <label class="input-label">이메일 주소</label>
                    <input type="email" name="email" class="form-control custom-input" placeholder="example@tenco.com">
                </div>

                <!-- 제출 버튼 -->
                <button type="submit" class="btn-join-submit">
                    회원가입 완료
                </button>
            </form>
        </div>

        <!-- 푸터 영역 (로그인 페이지 연결 등) -->
        <div class="join-footer">
            <span class="text-muted small">이미 계정이 있으신가요?</span>
            <a href="/login-form" class="ms-2">로그인하기</a>
        </div>
    </div>
</div>

{{> layout/footer}}