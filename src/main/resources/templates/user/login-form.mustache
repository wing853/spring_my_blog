{{> layout/header}}

<style>
    /* 전체 배경색 */
    body {
        background-color: #f1f5f9;
    }

    /* 로그인 카드 컨테이너 */
    .login-wrapper {
        max-width: 450px; /* 로그인 폼에 최적화된 너비 */
        margin: 80px auto;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }

    /* 카드 헤더 - 진한 경계선 스타일 */
    .login-header {
        padding: 40px 20px 25px;
        background-color: #ffffff;
        border-bottom: 2px solid #cbd5e1;
        text-align: center;
    }

    .login-header h2 {
        font-weight: 800;
        font-size: 1.7rem;
        color: #1e293b;
        letter-spacing: -1px;
        margin: 0;
    }

    .login-header p {
        color: #64748b;
        font-size: 0.95rem;
        margin-top: 10px;
    }

    /* 폼 영역 */
    .login-body {
        padding: 40px;
    }

    /* 입력창 커스텀 스타일 */
    .custom-input {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px 18px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        background-color: #fcfdfe;
        color: #334155;
    }

    .custom-input:focus {
        background-color: #ffffff;
        border-color: #6366f1; /* 메인 포인트 컬러 */
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        outline: none;
    }

    .input-label {
        font-weight: 700;
        font-size: 0.85rem;
        color: #475569;
        margin-bottom: 8px;
        display: block;
        margin-left: 4px;
    }

    /* 로그인 버튼 */
    .btn-login-submit {
        background-color: #1e293b; /* 헤더의 다크 톤과 일치 */
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 15px;
        width: 100%;
        font-weight: 700;
        font-size: 1.05rem;
        transition: all 0.3s;
        margin-top: 10px;
        cursor: pointer;
    }

    .btn-login-submit:hover {
        background-color: #0f172a;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    /* 하단 보조 링크 */
    .login-footer {
        text-align: center;
        padding: 20px;
        background-color: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

    .login-footer a {
        color: #6366f1;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.85rem;
    }
</style>

<div class="container flex-grow-1">
    <div class="login-wrapper">
        <!-- 로그인 헤더 -->
        <div class="login-header">
            <h2>Welcome Back! <i class="fa-solid fa-right-to-bracket ms-1"></i></h2>
            <p>다시 오신 것을 환영합니다</p>
        </div>

        <!-- 로그인 폼 -->
        <div class="login-body">
            <form action="/login" method="post">
                <!-- Username -->
                <div class="mb-4">
                    <label class="input-label">아이디</label>
                    <input type="text" name="username" class="form-control custom-input" placeholder="아이디를 입력하세요">
                </div>

                <!-- Password -->
                <div class="mb-4">
                    <label class="input-label">비밀번호</label>
                    <input type="password" name="password" class="form-control custom-input" placeholder="비밀번호를 입력하세요">
                </div>

                <!-- 로그인 버튼 -->
                <button type="submit" class="btn-login-submit">
                    로그인
                </button>
            </form>
        </div>

        <!-- 로그인 하단 링크 -->
        <div class="login-footer">
            <span class="text-muted small">아직 회원이 아니신가요?</span>
            <a href="/join-form" class="ms-2">회원가입 하기</a>
        </div>
    </div>
</div>

{{> layout/footer}}