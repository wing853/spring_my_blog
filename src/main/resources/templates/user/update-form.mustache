{{> layout/header}}

<style>
    /* 전체 배경색 */
    body {
        background-color: #f1f5f9;
    }

    /* 회원수정 카드 컨테이너 */
    .update-user-wrapper {
        max-width: 500px; /* 적절한 폼 너비 */
        margin: 60px auto;
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.05);
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }

    /* 카드 헤더 */
    .update-user-header {
        padding: 35px 20px;
        background-color: #ffffff;
        border-bottom: 2px solid #cbd5e1;
        text-align: center;
    }

    .update-user-header h2 {
        font-weight: 800;
        font-size: 1.6rem;
        color: #1e293b;
        letter-spacing: -1px;
        margin: 0;
    }

    .update-user-header p {
        color: #64748b;
        font-size: 0.9rem;
        margin-top: 10px;
    }

    /* 폼 영역 */
    .update-user-body {
        padding: 40px;
    }

    /* 입력창 공통 스타일 */
    .custom-input {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 13px 18px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        background-color: #fcfdfe;
        color: #334155;
    }

    .custom-input:focus {
        background-color: #ffffff;
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        outline: none;
    }

    /* 수정 불가(disabled) 스타일 */
    .custom-input:disabled {
        background-color: #f8fafc;
        color: #94a3b8;
        border-color: #f1f5f9;
        cursor: not-allowed;
    }

    .input-label {
        font-weight: 700;
        font-size: 0.85rem;
        color: #475569;
        margin-bottom: 8px;
        display: block;
        margin-left: 4px;
    }

    /* 수정 완료 버튼 */
    .btn-update-submit {
        background-color: #1e293b;
        color: #ffffff;
        border: none;
        border-radius: 12px;
        padding: 15px;
        width: 100%;
        font-weight: 700;
        font-size: 1.05rem;
        transition: all 0.3s;
        margin-top: 10px;
        cursor: pointer;
    }

    .btn-update-submit:hover {
        background-color: #0f172a;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }
</style>

<div class="container flex-grow-1">
    <div class="update-user-wrapper">
        <!-- 헤더 영역 -->
        <div class="update-user-header">
            <h2>Account Setting <i class="fa-solid fa-user-gear ms-1"></i></h2>
            <p>회원 정보를 안전하게 관리하세요</p>
        </div>

        <!-- 폼 영역 -->
        <div class="update-user-body">
            <form action="/user/update" method="post">

                <!-- 아이디 (수정불가) -->
                <div class="mb-4">
                    <label class="input-label">아이디</label>
                    <input type="text" class="form-control custom-input" value="{{user.username}}" disabled>
                    <small class="text-muted ms-1" style="font-size: 0.75rem;">아이디는 변경할 수 없습니다.</small>
                </div>

                <!-- 비밀번호 (수정가능) -->
                <div class="mb-4">
                    <label class="input-label">새 비밀번호</label>
                    <input type="password" name="password" class="form-control custom-input" placeholder="변경할 비밀번호를 입력하세요" required>
                </div>

                <!-- 이메일 (수정불가) -->
                <div class="mb-4">
                    <label class="input-label">이메일</label>
                    <input type="text" class="form-control custom-input" value="{{user.email}}" disabled>
                </div>

                <!-- 제출 버튼 -->
                <button type="submit" class="btn-update-submit">
                    회원정보 수정 완료
                </button>
            </form>
        </div>
    </div>
</div>

{{> layout/footer}}